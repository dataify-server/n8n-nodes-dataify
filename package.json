{
	"name": "n8n-nodes-dataify",
	"version": "0.1.1",
	"description": "n8n community node for listing and calling Dataify MCP tools",
	"license": "MIT",
	"homepage": "https://dataify.com",
	"keywords": [
		"n8n-community-node-package",
		"dataify",
		"mcp",
		"scraping",
		"search"
	],
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"audit:production": "node scripts/audit-production.cjs",
		"test": "npm run build",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist/credentials",
		"dist/nodes",
		"dist/shared",
		"dist/package.json"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/DataifyMcpApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/DataifyMcp/DataifyMcp.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.44.3",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "21.0.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"author": {
		"name": "dataify",
		"email": "service@dataify.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dataify-server/dataify-n8n.git"
	},
	"publishConfig": {
		"access": "public"
	}
}
